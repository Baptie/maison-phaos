# Apache (hébergement mutualisé OVH). Copié tel quel à la racine du site au build.
Options -Indexes
ErrorDocument 404 /404.html

# La redirection http -> https se règle dans l'espace client OVH (Hébergements > Multisite > SSL),
# pas ici : évite les boucles de redirection.

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Fichiers versionnés par Next.js : cache long
  <FilesMatch "\.(js|css|woff2?|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>
