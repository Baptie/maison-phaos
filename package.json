{
  "name": "maison-phaos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "build:dev": "NEXT_PUBLIC_SITE_MODE=dev next build && rm -rf dist-dev && mv out dist-dev",
    "build:prod": "NEXT_PUBLIC_SITE_MODE=prod next build && rm -rf dist-prod && mv out dist-prod",
    "dev:prod": "NEXT_PUBLIC_SITE_MODE=prod NEXT_DIST_DIR=.next-prod next dev -p 3001",
    "preview:dev": "python3 -m http.server 3000 -d dist-dev",
    "preview:prod": "python3 -m http.server 3001 -d dist-prod"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@portabletext/react": "8.0.1",
    "next": "16.3.8",
    "node-ical": "0.27.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
